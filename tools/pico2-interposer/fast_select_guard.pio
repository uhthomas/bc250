; Isolated Pi/Pico timing candidate. GP7 is an UNCONNECTED flash-CS# output.
; For each transaction preload: PASS=0/PATCH=1, expected 32-bit READ03
; command/address, and a 32-bit reply. On PATCH, the original flash is
; deselected before host CS# falls. PIO compares all 32 MOSI bits before it
; ever enables its MISO output. A mismatch latches IRQ0 and emits no reply.
; PASS still lacks an in-transaction command check. This is not board firmware.
.program fast_select_guard
.side_set 1 opt pindirs
.wrap_target
start:
    set pins, 1 side 0     ; flash deselected, Pico MISO high-Z on FIFO stall
    pull block
    mov y, osr              ; route
    pull block
    mov x, osr              ; expected command
    pull block              ; reply in OSR
    jmp !y pass
    wait 0 gpio 2           ; host CS# falls; flash already deselected
    set y, 31
command_bit:
    wait 1 gpio 3
    in pins, 1             ; MOSI, shift left to form big-endian command
    jmp y-- command_fall
    mov y, isr
    jmp x!=y fault
    out pins, 1 side 1     ; first reply bit only after full command matches
    set x, 30
    wait 0 gpio 3
data_bit:
    wait 1 gpio 3
    out pins, 1 side 1
    wait 0 gpio 3
    jmp x-- data_bit
    wait 1 gpio 3
    wait 1 gpio 2 side 0
    jmp start side 0
command_fall:
    wait 0 gpio 3
    jmp command_bit
fault:
    irq set 0               ; latched mismatch; no MISO output
    wait 1 gpio 2
    jmp fault               ; remain deselected/high-Z until host resets SM
pass:
    set pins, 0 side 0     ; select original flash before host CS# falls
    wait 0 gpio 2
    wait 1 gpio 2
.wrap
