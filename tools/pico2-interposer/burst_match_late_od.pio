; RAM-only exact-original READ03 control. The flash remains selected until
; the first 31 command bits match target>>1; after that, release flash CS#
; before the final address bit. The final bit must be zero (aligned target).
; Only then may GP5 drive the preloaded 64-byte reply. Future reads pass.
; GP7 is open-drain: output latch fixed LOW, PINDIRS=1 sinks, 0 releases.
.program burst_match_late_od
.side_set 1 opt pindirs
    pull block
    mov x, osr
    out null, 32
.wrap_target
start:
    set pindirs, 0 side 0
    wait 1 gpio 2
    wait 0 gpio 2
    set pindirs, 1 side 0
    set y, 30
command_bit:
    wait 1 gpio 3
    in pins, 1
    jmp y-- command_fall
    mov y, isr
    jmp x!=y pass
    set pindirs, 0 side 0 [3]
    wait 0 gpio 3
    wait 1 gpio 3
    jmp pin fault
    out pins, 1 side 1
    wait 0 gpio 3
data_bit:
    wait 1 gpio 3
    wait 0 gpio 3
    out pins, 1 side 1
    jmp !osre data_bit
    wait 1 gpio 2 side 1
    irq set 1 side 0
    mov x, ~null side 0
    jmp start
command_fall:
    wait 0 gpio 3
    jmp command_bit
fault:
    irq wait 0
pass:
    wait 1 gpio 2
    jmp start
.wrap
