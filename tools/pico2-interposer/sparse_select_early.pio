; Experimental sparse selector with first MISO bit driven during the final
; command bit. The 32-bit command is still checked before the reply phase.
; On mismatch, the fault instruction drops MISO output enable immediately.
; Use only with a complete observed profile and an exact-original control.
.program sparse_select_early
.side_set 1 opt pindirs
.wrap_target
start:
    set pindirs, 0 side 0
    set x, 0
    pull noblock
    mov y, osr
    jmp !y pass
    pull block
    mov x, osr
    pull block
    wait 0 gpio 2
    set y, 30
command_bit:
    wait 1 gpio 3
    in pins, 1
    wait 0 gpio 3
    jmp y-- command_bit
    out pins, 1 side 1
    wait 1 gpio 3
    in pins, 1
    mov y, isr
    jmp x!=y fault
    set x, 30
    wait 0 gpio 3
data_bit:
    wait 1 gpio 3
    wait 0 gpio 3
    out pins, 1 side 1
    jmp x-- data_bit
    wait 1 gpio 3
    wait 1 gpio 2 side 1
    jmp start side 0
fault:
    irq wait 0 side 0
pass:
    wait 0 gpio 2
    set pindirs, 1 side 0
    wait 1 gpio 2
.wrap
